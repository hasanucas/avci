# Laptop (Windows) de bu repoyu klonlayacak: Orin'de calisan dosyalar HER ZAMAN LF kalsin.
# (CRLF'li .sh -> "bad interpreter: /bin/bash^M")
*          text=auto
*.sh       text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.conf     text eol=lf
*.txt      text eol=lf
*.md       text eol=lf
*.c        text eol=lf
*.cpp      text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
CMakeLists.txt text eol=lf

# Windows tarafi scriptleri
*.ps1      text eol=crlf
*.bat      text eol=crlf

# Ikili
*.pt       binary
*.pth      binary
*.engine   binary
*.onnx     binary
*.apj      binary
